<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色主题（DayNight：随系统切换，见 values-night/themes.xml） -->
    <style name="Theme.Fx991" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/calc_body</item>
        <item name="android:statusBarColor">@color/calc_body_edge</item>
        <item name="android:navigationBarColor">@color/calc_body_edge</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- edge-to-edge：允许内容延伸进刘海 / 挖孔区域，避让由 Compose 的 safeDrawing insets 负责（API 28+） -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
